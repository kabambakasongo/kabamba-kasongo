# ---------------------------------------------------------------------------
# Copiez ce fichier vers `.env` puis renseignez vos valeurs.
# Toutes les variables sont OPTIONNELLES : le portfolio fonctionne
# parfaitement sans aucune d'entre elles.
#
# Aucune valeur n'est devinee par le projet. Laissez vide ce que vous ne
# souhaitez pas publier : les elements concernes sont alors masques.
# ---------------------------------------------------------------------------

# URL publique du site, utilisee par robots.txt, sitemap.xml, la page 404 et
# les balises SEO (canonical, Open Graph, Twitter Card, JSON-LD).
# Exemple : https://votre-pseudo.github.io
# Laissez vide en developpement : le build utilise alors un domaine de
# remplacement reserve et les balises se rabattent sur le domaine visite.
SITE_URL=
VITE_SITE_URL=

# Chemin de base du deploiement.
#   "./"  -> fonctionne sur un site projet GitHub Pages quel que soit le nom du repo (defaut)
#   "/"    -> pour un domaine custom (ex: mon-domaine.dev)
VITE_BASE_PATH=./

# ---------------------------------------------------------------------------
# Identifiant GitHub (une seule variable a modifier, sans toucher au code)
# Surcharge le champ `github` de src/config/profile.ts si elle est renseignee.
# Laissez vide pour masquer la section GitHub et ses statistiques.
# ---------------------------------------------------------------------------
VITE_GITHUB_USERNAME=

# ---------------------------------------------------------------------------
# Formulaire de contact (aucun backend requis)
# Valeurs possibles : none | web3forms | formspree | emailjs
# ---------------------------------------------------------------------------
VITE_CONTACT_PROVIDER=none

# Web3Forms : cle publique fournie sur https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree : URL du formulaire, ex :
# https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=

# EmailJS : identifiants de service, de modele et cle publique
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
