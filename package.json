{
  "name": "kabamba-kasongo-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio de KABAMBA KASONGO, developpeur Full-Stack specialise dans les applications web, SaaS et solutions digitales.",
  "author": "KABAMBA KASONGO",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/inject-seo.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/ssr-smoke.mjs",
    "verify": "node scripts/browser-check.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,html,yml,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,html,yml,mjs}\""
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
